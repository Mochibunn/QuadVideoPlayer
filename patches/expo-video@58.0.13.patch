index 0000000000000000000000000000000000000000..6ce2840f5699b1b8e85909b553598365076a673e
--- /dev/null
+++ b/android/src/main/java/expo/modules/video/player/LoudnessNormalizerAudioProcessor.kt
@@ -0,0 +1,191 @@
+package expo.modules.video.player
+
+import androidx.media3.common.C
+import androidx.media3.common.audio.AudioProcessor
+import androidx.media3.common.audio.BaseAudioProcessor
+import androidx.media3.common.util.UnstableApi
+import java.nio.ByteBuffer
+import java.nio.ByteOrder
+import java.util.ArrayDeque
+import kotlin.math.PI
+import kotlin.math.abs
+import kotlin.math.exp
+import kotlin.math.log10
+import kotlin.math.min
+import kotlin.math.pow
+import kotlin.math.tan
+
+@UnstableApi
+internal class LoudnessNormalizerAudioProcessor : BaseAudioProcessor() {
+  @Volatile
+  var enabled = false
+
+  private var windowSquareSum = 0.0
+  private var windowSampleCount = 0
+  private var gain = 1.0
+  private var wantedGain = 1.0
+  private var channel = 0
+  private var filters = emptyArray<KWeightingFilter>()
+  private val energies = ArrayDeque<Double>()
+  private var attack = 0.0
+  private var release = 0.0
+
+  override fun onConfigure(inputAudioFormat: AudioProcessor.AudioFormat): AudioProcessor.AudioFormat {
+    return if (
+      inputAudioFormat.encoding == C.ENCODING_PCM_16BIT ||
+      inputAudioFormat.encoding == C.ENCODING_PCM_FLOAT
+    ) {
+      filters = Array(inputAudioFormat.channelCount) { KWeightingFilter(inputAudioFormat.sampleRate) }
+      val samplesPerSecond = inputAudioFormat.sampleRate.toDouble() * inputAudioFormat.channelCount
+      attack = 1.0 - exp(-1.0 / (samplesPerSecond * 0.15))
+      release = 1.0 - exp(-1.0 / (samplesPerSecond * 1.5))
+      inputAudioFormat
+    } else {
+      AudioProcessor.AudioFormat.NOT_SET
+    }
+  }
+
+  override fun queueInput(inputBuffer: ByteBuffer) {
+    // Media3 legitimately queues EMPTY_BUFFER while draining the pipeline.
+    // BaseAudioProcessor can reuse that same shared buffer as its output.
+    // Empty input must be a no-op BEFORE replaceOutputBuffer clears/reuses it;
+    // otherwise put(input) attempts a self-copy or discards pending output.
+    if (!inputBuffer.hasRemaining()) return
+
+    val outputBuffer = replaceOutputBuffer(inputBuffer.remaining()).order(ByteOrder.LITTLE_ENDIAN)
+    val input = inputBuffer.order(ByteOrder.LITTLE_ENDIAN)
+    if (!enabled) {
+      outputBuffer.put(input)
+      resetLevels()
+      outputBuffer.flip()
+      return
+    }
+
+    val format = inputAudioFormat
+    val floatPcm = format.encoding == C.ENCODING_PCM_FLOAT
+    val samplesPerWindow = (format.sampleRate * format.channelCount * 2 / 5).coerceAtLeast(1)
+    val preview = input.asReadOnlyBuffer().order(ByteOrder.LITTLE_ENDIAN)
+    var peak = 0.0
+    while (preview.remaining() >= if (floatPcm) 4 else 2) {
+      val sample = if (floatPcm) preview.float.toDouble() else preview.short.toDouble() / 32768.0
+      if (sample.isFinite()) peak = maxOf(peak, abs(sample))
+    }
+    val peakGainCeiling = if (peak > 0.0) 0.98 / peak else 4.0
+    while (input.remaining() >= if (format.encoding == C.ENCODING_PCM_FLOAT) 4 else 2) {
+      val sample = if (format.encoding == C.ENCODING_PCM_FLOAT) {
+        input.float.toDouble()
+      } else {
+        input.short.toDouble() / 32768.0
+      }.let { if (it.isFinite()) it.coerceIn(-1.0, 1.0) else 0.0 }
+
+      val weighted = filters[channel].process(sample)
+      // Android's six/eight-channel PCM order places LFE at index 3.
+      val channelWeight = when {
+        format.channelCount >= 6 && channel == 3 -> 0.0
+        format.channelCount >= 6 && channel >= 4 -> 1.41
+        else -> 1.0
+      }
+      windowSquareSum += weighted * weighted * channelWeight
+      channel = (channel + 1) % format.channelCount
+      windowSampleCount += 1
+      if (windowSampleCount >= samplesPerWindow) {
+        val energy = windowSquareSum / windowSampleCount * format.channelCount
+        // BS.1770 K-weighting and absolute/relative gating, measured live.
+        // Eight 400 ms windows avoid whole-file scans and retain quick source changes.
+        if (energy > 10.0.pow((-70.0 + 0.691) / 10.0)) {
+          energies.addLast(energy)
+          if (energies.size > 8) energies.removeFirst()
+          val relativeGate = energies.average() / 10.0
+          val gated = energies.filter { it >= relativeGate }.average()
+          val loudness = -0.691 + 10.0 * log10(gated)
+          wantedGain = 10.0.pow((-18.0 - loudness).coerceIn(-12.0, 12.0) / 20.0)
+        }
+        windowSquareSum = 0.0
+        windowSampleCount = 0
+      }
+
+      gain += (wantedGain - gain) * if (wantedGain < gain) attack else release
+      val normalized = (sample * min(gain, peakGainCeiling)).coerceIn(-0.98, 0.98)
+      if (format.encoding == C.ENCODING_PCM_FLOAT) {
+        outputBuffer.putFloat(normalized.toFloat())
+      } else {
+        outputBuffer.putShort((normalized * 32767.0).toInt().toShort())
+      }
+    }
+    outputBuffer.flip()
+  }
+
+  override fun onFlush() {
+    resetLevels()
+  }
+
+  override fun onReset() {
+    resetLevels()
+  }
+
+  private fun resetLevels() {
+    windowSquareSum = 0.0
+    windowSampleCount = 0
+    gain = 1.0
+    wantedGain = 1.0
+    channel = 0
+    energies.clear()
+    filters.forEach { it.reset() }
+  }
+}
+
+// Coefficients from ITU-R BS.1770's pre-filter and RLB weighting stages.
+private class KWeightingFilter(sampleRate: Int) {
+  private val shelf: Biquad
+  private val highPass: Biquad
+
+  init {
+    var k = tan(PI * 1681.974450955533 / sampleRate)
+    val vh = 10.0.pow(3.999843853973347 / 20.0)
+    val vb = vh.pow(0.4996667741545416)
+    val q = 0.7071752369554196
+    var a0 = 1.0 + k / q + k * k
+    shelf = Biquad(
+      (vh + vb * k / q + k * k) / a0,
+      2.0 * (k * k - vh) / a0,
+      (vh - vb * k / q + k * k) / a0,
+      2.0 * (k * k - 1.0) / a0,
+      (1.0 - k / q + k * k) / a0
+    )
+    k = tan(PI * 38.13547087602444 / sampleRate)
+    val hpQ = 0.5003270373238773
+    a0 = 1.0 + k / hpQ + k * k
+    highPass = Biquad(
+      1.0, -2.0, 1.0,
+      2.0 * (k * k - 1.0) / a0,
+      (1.0 - k / hpQ + k * k) / a0
+    )
+  }
+
+  fun process(sample: Double) = highPass.process(shelf.process(sample))
+  fun reset() {
+    shelf.reset()
+    highPass.reset()
+  }
+}
+
+private class Biquad(
+  private val b0: Double,
+  private val b1: Double,
+  private val b2: Double,
+  private val a1: Double,
+  private val a2: Double
+) {
+  private var z1 = 0.0
+  private var z2 = 0.0
+  fun process(sample: Double): Double {
+    val output = b0 * sample + z1
+    z1 = b1 * sample - a1 * output + z2
+    z2 = b2 * sample - a2 * output
+    return output
+  }
+  fun reset() {
+    z1 = 0.0
+    z2 = 0.0
+  }
+}
