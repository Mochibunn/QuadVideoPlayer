diff --git a/android/src/test/java/expo/modules/video/player/LoudnessNormalizerAudioProcessorTest.kt b/android/src/test/java/expo/modules/video/player/LoudnessNormalizerAudioProcessorTest.kt
new file mode 100644
index 0000000000000000000000000000000000000000..c214037095efcad679321f6ce413381225f7f3c7
--- /dev/null
+++ b/android/src/test/java/expo/modules/video/player/LoudnessNormalizerAudioProcessorTest.kt
@@ -0,0 +1,163 @@
+package expo.modules.video.player
+
+import androidx.media3.common.C
+import androidx.media3.common.audio.AudioProcessor
+import androidx.media3.common.util.UnstableApi
+import org.junit.Assert.assertArrayEquals
+import org.junit.Assert.assertTrue
+import org.junit.Test
+import java.nio.ByteBuffer
+import java.nio.ByteOrder
+import kotlin.math.PI
+import kotlin.math.abs
+import kotlin.math.sin
+import kotlin.math.sqrt
+
+@UnstableApi
+class LoudnessNormalizerAudioProcessorTest {
+  private fun processor(enabled: Boolean): LoudnessNormalizerAudioProcessor {
+    return LoudnessNormalizerAudioProcessor().apply {
+      configure(AudioProcessor.AudioFormat(48000, 1, C.ENCODING_PCM_16BIT))
+      flush()
+      this.enabled = enabled
+    }
+  }
+
+  @Test
+  fun emptyDrainBufferIsANoOpWhenDisabled() {
+    val processor = processor(false)
+    processor.queueInput(AudioProcessor.EMPTY_BUFFER)
+    assertTrue(!processor.output.hasRemaining())
+  }
+
+  @Test
+  fun emptyBuffersAcrossFlushAndEndOfStreamAreSafeInBothModes() {
+    for (enabled in listOf(false, true)) {
+      val processor = processor(enabled)
+      repeat(3) {
+        processor.flush()
+        processor.queueInput(AudioProcessor.EMPTY_BUFFER)
+        assertTrue(!processor.output.hasRemaining())
+        processor.queueInput(tone(0.1, 0))
+        val output = processor.output
+        assertTrue(output.hasRemaining())
+        output.position(output.limit())
+        processor.queueInput(AudioProcessor.EMPTY_BUFFER)
+        assertTrue(!processor.output.hasRemaining())
+        processor.queueEndOfStream()
+        assertTrue(processor.isEnded)
+      }
+    }
+  }
+
+  @Test
+  fun emptyInputPreservesPendingOutputInBothModes() {
+    for (enabled in listOf(false, true)) {
+      val reference = processor(enabled)
+      reference.queueInput(tone(0.1, 0))
+      val expectedBuffer = reference.output
+      val expected = ByteArray(expectedBuffer.remaining())
+      expectedBuffer.get(expected)
+
+      val processor = processor(enabled)
+      processor.queueInput(tone(0.1, 0))
+      processor.queueInput(AudioProcessor.EMPTY_BUFFER)
+      val output = processor.output
+      val actual = ByteArray(output.remaining())
+      output.get(actual)
+      assertArrayEquals(expected, actual)
+    }
+  }
+
+  @Test
+  fun consumedOutputCanBeQueuedAsAnEmptyDrainBuffer() {
+    for (enabled in listOf(false, true)) {
+      val processor = processor(enabled)
+      processor.queueInput(tone(0.1, 0))
+      val output = processor.output
+      output.position(output.limit())
+      processor.queueInput(output)
+      assertTrue(!processor.output.hasRemaining())
+    }
+  }
+
+  @Test
+  fun floatStereoPcmSurvivesEmptyDrainsInBothModes() {
+    val input = ByteBuffer.allocate(16).order(ByteOrder.LITTLE_ENDIAN)
+      .putFloat(0.125f).putFloat(-0.125f).putFloat(0.25f).putFloat(-0.25f).array()
+    for (enabled in listOf(false, true)) {
+      val processor = LoudnessNormalizerAudioProcessor().apply {
+        configure(AudioProcessor.AudioFormat(48000, 2, C.ENCODING_PCM_FLOAT))
+        flush()
+        this.enabled = enabled
+      }
+      processor.queueInput(AudioProcessor.EMPTY_BUFFER)
+      processor.queueInput(ByteBuffer.wrap(input).order(ByteOrder.LITTLE_ENDIAN))
+      val actual = ByteArray(input.size)
+      processor.output.get(actual)
+      assertArrayEquals(input, actual)
+      processor.queueInput(AudioProcessor.EMPTY_BUFFER)
+      processor.queueEndOfStream()
+      assertTrue(processor.isEnded)
+    }
+  }
+
+  @Test
+  fun disabledIsBitExact() {
+    val processor = processor(false)
+    val bytes = byteArrayOf(0, 0, 127, 127, -1, -1, 0, -128)
+    processor.queueInput(ByteBuffer.wrap(bytes).order(ByteOrder.LITTLE_ENDIAN))
+    val actual = ByteArray(bytes.size)
+    processor.output.get(actual)
+    assertArrayEquals(bytes, actual)
+  }
+
+  @Test
+  fun quietAndLoudInputsConvergeToMatchingLoudness() {
+    val quiet = finalRms(0.06)
+    val loud = finalRms(0.5)
+    assertTrue("Quiet input must actually be amplified", quiet > 0.08)
+    assertTrue("Loud input must actually be attenuated", loud < 0.2)
+    assertTrue("Different input levels should converge: $quiet / $loud", abs(quiet / loud - 1.0) < 0.08)
+  }
+
+  @Test
+  fun normalizedPcmDoesNotClip() {
+    val processor = processor(true)
+    repeat(600) { block ->
+      val amplitude = if (block < 500) 0.04 else 0.99
+      processor.queueInput(tone(amplitude, block * 960))
+      val output = processor.output.order(ByteOrder.LITTLE_ENDIAN)
+      while (output.remaining() >= 2) {
+        assertTrue(abs(output.short.toInt()) <= 32113)
+      }
+    }
+  }
+
+  private fun finalRms(amplitude: Double): Double {
+    val processor = processor(true)
+    var sum = 0.0
+    var count = 0
+    repeat(600) { block ->
+      processor.queueInput(tone(amplitude, block * 960))
+      val output = processor.output.order(ByteOrder.LITTLE_ENDIAN)
+      while (output.remaining() >= 2) {
+        val sample = output.short.toDouble() / 32768.0
+        if (block >= 500) {
+          sum += sample * sample
+          count += 1
+        }
+      }
+    }
+    return sqrt(sum / count)
+  }
+
+  private fun tone(amplitude: Double, offset: Int): ByteBuffer {
+    return ByteBuffer.allocateDirect(960 * 2).order(ByteOrder.LITTLE_ENDIAN).apply {
+      repeat(960) { sample ->
+        putShort((sin(2.0 * PI * 1000.0 * (offset + sample) / 48000) * amplitude * 32767).toInt().toShort())
+      }
+      flip()
+    }
+  }
+}
