+package expo.modules.video.player
+
+import androidx.media3.common.C
+import androidx.media3.common.audio.AudioProcessor
+import org.junit.Assert.*
+import org.junit.Test
+import java.nio.ByteBuffer
+import java.nio.ByteOrder
+import kotlin.math.*
+
+class SoundEffectsAudioProcessorTest {
+  private fun processor(settings: SoundEffectsAudioProcessor.Settings, channels: Int = 1, floats: Boolean = true) =
+    SoundEffectsAudioProcessor().apply {
+      this.settings = settings
+      configure(AudioProcessor.AudioFormat(48000, channels, if (floats) C.ENCODING_PCM_FLOAT else C.ENCODING_PCM_16BIT))
+      flush()
+    }
+
+  private fun samples(processor: SoundEffectsAudioProcessor, input: FloatArray): FloatArray {
+    val buffer = ByteBuffer.allocateDirect(input.size * 4).order(ByteOrder.LITTLE_ENDIAN)
+    input.forEach { buffer.putFloat(it) }
+    buffer.flip()
+    processor.queueInput(buffer)
+    val output = processor.output.order(ByteOrder.LITTLE_ENDIAN)
+    return FloatArray(output.remaining() / 4) { output.float }
+  }
+
+  @Test fun bypassIsBitExactAndEmptyDoesNotDiscardOutput() {
+    val p = processor(SoundEffectsAudioProcessor.Settings())
+    val input = byteArrayOf(0, 0, 0, 63)
+    p.queueInput(ByteBuffer.wrap(input))
+    p.queueInput(AudioProcessor.EMPTY_BUFFER)
+    val output = p.output
+    assertArrayEquals(input, ByteArray(output.remaining()).also { output.get(it) })
+    p.queueInput(AudioProcessor.EMPTY_BUFFER)
+  }
+  @Test fun perTrackGainBoostsOnlyThatPlayerAndNeverOverflows() {
+    val boost = processor(SoundEffectsAudioProcessor.Settings(gain = 2.0))
+    boost.queueInput(AudioProcessor.EMPTY_BUFFER)
+    assertArrayEquals(floatArrayOf(0.5f, -0.25f), samples(boost, floatArrayOf(0.25f, -0.125f)), 0f)
+    assertArrayEquals(floatArrayOf(0.98f, -0.98f),
+      samples(processor(SoundEffectsAudioProcessor.Settings(gain = 8.0)), floatArrayOf(0.9f, -0.9f)), 0f)
+    assertArrayEquals(floatArrayOf(0.25f), samples(processor(SoundEffectsAudioProcessor.Settings()), floatArrayOf(0.25f)), 0f)
+    assertEquals(2.0, processor(SoundEffectsAudioProcessor.Settings(gain = 8.0)).settings.linearGain, 0.0)
+    assertEquals(1.0, processor(SoundEffectsAudioProcessor.Settings(gain = 0.25)).settings.linearGain, 0.0)
+  }
+  @Test fun everyEffectHandlesEmptyInput() {
+    for (mode in listOf("off", "room", "hall", "plate")) {
+      val p = processor(SoundEffectsAudioProcessor.Settings(eq = true, reverb = mode, echo = true))
+      p.queueInput(AudioProcessor.EMPTY_BUFFER)
+      samples(p, FloatArray(1024) { 0.1f })
+      p.queueInput(AudioProcessor.EMPTY_BUFFER)
+      p.queueEndOfStream()
+    }
+  }
+  @Test fun reverbPresetsHaveDifferentTails() {
+    val tails = listOf("room", "hall", "plate").map { mode ->
+      val p = processor(SoundEffectsAudioProcessor.Settings(reverb = mode))
+      samples(p, FloatArray(24000) { if (it == 0) 0.5f else 0f })
+    }
+    tails.forEach { tail -> assertTrue(tail.drop(1).any { abs(it) > 0.00001 }) }
+    assertFalse(tails[0].contentEquals(tails[1]))
+    assertFalse(tails[1].contentEquals(tails[2]))
+  }
+  @Test fun echoProducesDelayedSignal() {
+    val p = processor(SoundEffectsAudioProcessor.Settings(echo = true))
+    val output = samples(p, FloatArray(20000) { if (it == 0) 0.5f else 0f })
+    assertEquals(0.4f, output[0], 0.0001f)
+    assertTrue(output[13440] > 0.09f)
+  }
+  @Test fun eqCutsItsTargetBand() {
+    val tone = FloatArray(48000) { (0.2 * sin(2 * PI * 910 * it / 48000)).toFloat() }
+    val flat = samples(processor(SoundEffectsAudioProcessor.Settings(eq = true)), tone)
+    val cut = samples(processor(SoundEffectsAudioProcessor.Settings(eq = true, bands = listOf(0.0, 0.0, -12.0, 0.0, 0.0))), tone)
+    fun energy(values: FloatArray) = values.drop(1000).sumOf { it.toDouble() * it }
+    assertTrue(energy(cut) < energy(flat) * 0.1)
+  }
+  @Test fun stereoChannelsDoNotLeak() {
+    val p = processor(SoundEffectsAudioProcessor.Settings(reverb = "hall", echo = true), channels = 2)
+    val output = samples(p, FloatArray(48000) { if (it == 0) 0.5f else 0f })
+    assertTrue(output.filterIndexed { index, _ -> index % 2 == 1 }.all { it == 0f })
+  }
+  @Test fun flushClearsDelayAndDisablingIsExactBypass() {
+    val p = processor(SoundEffectsAudioProcessor.Settings(echo = true))
+    samples(p, FloatArray(1000) { 0.5f })
+    p.flush()
+    assertTrue(samples(p, FloatArray(20000)).all { it == 0f })
+    p.settings = SoundEffectsAudioProcessor.Settings()
+    assertArrayEquals(floatArrayOf(0.2f, -0.5f), samples(p, floatArrayOf(0.2f, -0.5f)), 0f)
+  }
+  @Test fun integerPcmAndNonFiniteFloatStayBounded() {
+    val config = SoundEffectsAudioProcessor.Settings(eq = true, bands = List(5) { 12.0 }, reverb = "plate", echo = true)
+    val p = processor(config, floats = false)
+    val input = ByteBuffer.allocateDirect(4000).order(ByteOrder.LITTLE_ENDIAN)
+    repeat(2000) { input.putShort(Short.MAX_VALUE) }
+    input.flip()
+    p.queueInput(input)
+    assertEquals(4000, p.output.remaining())
+    val output = samples(processor(config), floatArrayOf(Float.NaN, Float.POSITIVE_INFINITY, 1f, -1f))
+    assertTrue(output.all { it.isFinite() && abs(it) <= 0.981f })
+  }
+}
