+++ b/android/src/main/java/expo/modules/video/player/SoundEffectsAudioProcessor.kt
@@ -0,0 +1,166 @@
+package expo.modules.video.player
+
+import androidx.media3.common.C
+import androidx.media3.common.audio.AudioProcessor
+import androidx.media3.common.audio.BaseAudioProcessor
+import androidx.media3.common.util.UnstableApi
+import org.json.JSONObject
+import java.nio.ByteBuffer
+import java.nio.ByteOrder
+import kotlin.math.*
+
+/** Per-player PCM effects; no platform audio-session effects or global mixer. */
+@UnstableApi
+internal class SoundEffectsAudioProcessor : BaseAudioProcessor() {
+  data class Settings(
+    val eq: Boolean = false,
+    val bands: List<Double> = List(5) { 0.0 },
+    val reverb: String = "off",
+    val echo: Boolean = false,
+    val gain: Double = 1.0
+  ) {
+    val linearGain get() = if (gain.isFinite()) gain.coerceIn(1.0, 2.0) else 1.0
+    val active get() = eq || reverb != "off" || echo || linearGain > 1.0
+  }
+
+  @Volatile var settings = Settings()
+  private var applied: Settings? = null
+  private var channels = emptyArray<Channel>()
+  private var channelIndex = 0
+  private var headroom = 1.0
+
+  fun setJson(value: String) {
+    val json = JSONObject(value)
+    val bands = json.optJSONArray("bands")
+    settings = Settings(
+      eq = json.optBoolean("eq"),
+      bands = List(5) { i ->
+        (bands?.optDouble(i, 0.0) ?: 0.0).let { if (it.isFinite()) it.coerceIn(-12.0, 12.0) else 0.0 }
+      },
+      reverb = json.optString("reverb", "off").takeIf { it in listOf("room", "hall", "plate") } ?: "off",
+      echo = json.optBoolean("echo"),
+      gain = json.optDouble("gain", 1.0).let { if (it.isFinite()) it.coerceIn(1.0, 2.0) else 1.0 }
+    )
+  }
+
+  override fun onConfigure(format: AudioProcessor.AudioFormat): AudioProcessor.AudioFormat {
+    applied = null
+    return if (format.encoding == C.ENCODING_PCM_16BIT || format.encoding == C.ENCODING_PCM_FLOAT)
+      format else AudioProcessor.AudioFormat.NOT_SET
+  }
+
+  override fun queueInput(inputBuffer: ByteBuffer) {
+    // Preserve Media3's shared empty sentinel and pending output.
+    if (!inputBuffer.hasRemaining()) return
+    val config = settings
+    if (applied != config) {
+      channels = if (config.active)
+        Array(inputAudioFormat.channelCount) { Channel(inputAudioFormat.sampleRate, config, it) }
+      else emptyArray()
+      channelIndex = 0
+      // Pre-attenuate boosted EQ bands instead of making loud presets clip.
+      headroom = if (config.eq) 10.0.pow(-config.bands.filter { it > 0 }.sum() / 20.0) else 1.0
+      applied = config
+    }
+    val output = replaceOutputBuffer(inputBuffer.remaining()).order(ByteOrder.LITTLE_ENDIAN)
+    if (!config.active) {
+      output.put(inputBuffer)
+      output.flip()
+      return
+    }
+    val input = inputBuffer.order(ByteOrder.LITTLE_ENDIAN)
+    val floats = inputAudioFormat.encoding == C.ENCODING_PCM_FLOAT
+    while (input.remaining() >= if (floats) 4 else 2) {
+      val raw = if (floats) input.float.toDouble() else input.short / 32768.0
+      val sample = if (raw.isFinite()) raw.coerceIn(-1.0, 1.0) else 0.0
+      val processed = channels[channelIndex].process(sample * headroom)
+      channelIndex = (channelIndex + 1) % channels.size
+      val amplified = processed * config.linearGain
+      val safe = if (amplified.isFinite()) amplified.coerceIn(-0.98, 0.98) else 0.0
+      if (floats) output.putFloat(safe.toFloat())
+      else output.putShort((safe * 32767).roundToInt().toShort())
+    }
+    output.flip()
+  }
+
+  override fun onFlush() { applied = null; channels = emptyArray(); channelIndex = 0 }
+  override fun onReset() = onFlush()
+
+  private class Channel(rate: Int, config: Settings, index: Int) {
+    private val filters = if (config.eq)
+      listOf(60.0, 230.0, 910.0, 3600.0, 14000.0).mapIndexed { i, frequency ->
+        PeakFilter(rate, min(frequency, rate * 0.45), config.bands[i])
+      } else emptyList()
+    private val combs = if (config.reverb != "off") {
+      val times = when (config.reverb) {
+        "room" -> listOf(0.019, 0.023, 0.029, 0.031)
+        "plate" -> listOf(0.029, 0.037, 0.041, 0.053)
+        else -> listOf(0.043, 0.059, 0.071, 0.089)
+      }
+      val feedback = when (config.reverb) { "room" -> 0.57; "plate" -> 0.77; else -> 0.84 }
+      times.map { Comb((rate * it).toInt() + index * 23, feedback) }
+    } else emptyList()
+    private val diffusion = if (combs.isNotEmpty())
+      listOf(AllPass((rate * 0.005).toInt()), AllPass((rate * 0.0017).toInt())) else emptyList()
+    private val echo = if (config.echo) Comb((rate * 0.28).toInt(), 0.36) else null
+
+    fun process(input: Double): Double {
+      var dry = input
+      for (filter in filters) dry = filter.process(dry)
+      var result = dry
+      if (combs.isNotEmpty()) {
+        var wet = 0.0
+        for (comb in combs) wet += comb.process(dry) * 0.25
+        for (allPass in diffusion) wet = allPass.process(wet)
+        result = 0.78 * dry + 0.22 * wet
+      }
+      echo?.let { result = 0.8 * result + 0.2 * it.process(result) }
+      return result
+    }
+  }
+
+  private class Comb(size: Int, private val feedback: Double) {
+    private val buffer = DoubleArray(size.coerceAtLeast(1))
+    private var position = 0
+    private var damped = 0.0
+    fun process(input: Double): Double {
+      val output = buffer[position]
+      damped = output * 0.65 + damped * 0.35
+      buffer[position] = input + damped * feedback
+      position = (position + 1) % buffer.size
+      return output
+    }
+  }
+
+  private class AllPass(size: Int) {
+    private val buffer = DoubleArray(size.coerceAtLeast(1))
+    private var position = 0
+    fun process(input: Double): Double {
+      val delayed = buffer[position]
+      val output = delayed - input
+      buffer[position] = input + delayed * 0.5
+      position = (position + 1) % buffer.size
+      return output
+    }
+  }
+
+  private class PeakFilter(rate: Int, frequency: Double, gain: Double) {
+    private val a = 10.0.pow(gain / 40.0)
+    private val omega = 2 * PI * frequency / rate
+    private val alpha = sin(omega) / 2 // Q=1
+    private val a0 = 1 + alpha / a
+    private val b0 = (1 + alpha * a) / a0
+    private val b1 = -2 * cos(omega) / a0
+    private val b2 = (1 - alpha * a) / a0
+    private val a1 = b1
+    private val a2 = (1 - alpha / a) / a0
+    private var z1 = 0.0
+    private var z2 = 0.0
+    fun process(input: Double): Double {
+      val output = b0 * input + z1
+      z1 = b1 * input - a1 * output + z2
+      z2 = b2 * input - a2 * output
+      return output
+    }
+  }
+}
