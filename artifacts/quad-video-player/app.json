{
  "expo": {
    "name": "Quad Video Player",
    "slug": "quad-video-player",
    "version": "1.0.0",
    "platforms": ["ios", "android"],
    "orientation": "landscape",
    "icon": "./assets/images/icon.png",
    "scheme": "quad-video-player",
    "userInterfaceStyle": "dark",
    "splash": {
      "backgroundColor": "#000000"
    },
    "ios": {
      "supportsTablet": false
    },
    "android": {},
    "plugins": [
      "expo-router",
      "expo-video"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
